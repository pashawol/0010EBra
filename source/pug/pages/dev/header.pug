extends ../../layout/main.pug

//- Строительные леса для сверки шапки + попапа каталога с макетом
//- (318:527 / 777:28 / 607:2934 / 607:3054 / 609:4165). Папку dev/ координатор
//- удалит при сдаче — сюда НЕ добавлять реальный контент страницы.
include ../../blocks/header/_header.pug
include ../../blocks/top-nav/_top-nav.pug

//- Страница лежит в подпапке (public/dev/header.html) — относительные css/js
//- из +allcss()/+allcjs() промахиваются на уровень без этого <base>.
block base
	base(href="../")

block variables
	- let mainPage = 'dev-page'
	- let bg = null

block title
	- let title = 'DEV — header + catalog popup'
	title= title

block pagecontent
	+header()
		+top-nav()

	//- Инлайн style="" вместо <style>-блока: html-validate (element-permitted-content)
	//- не пускает <style> внутрь <div>/<body> без атрибута scoped — это только
	//- строительные леса, отдельный CSS-файл под dev-страницу заводить незачем.
	main.dev-stand
		.dev-stand__spacer.eb-theme--dark(style="min-height:100vh; padding-top:200px; background:var(--eb-burgundy);")
			.container
				p.dev-stand__hint(style="max-width:32rem; color:var(--eb-white);")
					| Тёмная секция имитирует первый экран (sHero) — хедер поверх неё
					|  должен быть прозрачным. Проскролльте вниз — при scrollY&gt;0
					|  JSCCommon.setFixedNav() добавит `.fixed`.
				button.dev-stand__open(
					type="button"
					data-catalog-open
					aria-haspopup="dialog"
					aria-expanded="false"
					aria-controls="catalogModal"
					style="margin-top:24px; padding:14px 24px; border:0; border-radius:14px; background:var(--eb-white); cursor:pointer;"
				)
					| Открыть попап каталога
		.dev-stand__filler(style="min-height:100vh; padding-top:80px;")
			.container
				p Дальше идёт светлая секция — просто для скролла и проверки `.fixed`.

block scripts
	script(src="js/header.js")
