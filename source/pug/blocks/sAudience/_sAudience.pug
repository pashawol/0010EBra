mixin sAudience(data)
	- data = data || sAudience
	// start sAudience
	+b.SECTION.sAudience.section#sAudience&attributes(attributes)
		block
		.container
			+e.DIV.grid
				+ebTitle(data.title).sAudience__title

				each card, i in data.cards
					+e.A(class="card--" + card.mod href=card.href || '#')
						img.sAudience__card-img(src="img/sAudience/" + card.image alt="" loading=(i === 0 ? undefined : "lazy"))
						+e.SPAN.card-text!= card.text
						+e.SPAN.card-arrow
							+icon('arrow-right')

				+e.DIV.widget
					+e.DIV.avatars
						each avatar, i in data.avatars
							img.sAudience__avatar(src="img/sAudience/" + avatar alt="" loading="lazy" style=`z-index: ${data.avatars.length - i}`)
					+e.SPAN.widget-text= data.widgetText
	// end sAudience
