extends ../../layout/main.pug

//- Строительные леса для локальной QA-проверки sCollection. Папку dev/
//- удаляет координатор при сдаче — здесь только этот блок, шапка/футер не нужны.
include ../../blocks/sCollection/_sCollection.pug

block variables
	- var mainPage = 'main-page'

//- Страница лежит в public/dev/ — относительные пути к css/js/img
//- промахиваются на уровень без этого блока (см. sFitting/sReels/sStory dev).
block base
	base(href="../")

block title
	- var title = 'DEV — sCollection'
	title= title

block pagecontent
	main
		+sCollection()
