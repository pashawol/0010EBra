extends ../../layout/main.pug

//- Строительные леса для локальной QA-проверки sPromo. Папку dev/ удаляет
//- координатор при сдаче — здесь только этот блок, шапка/футер не нужны.
include ../../blocks/sPromo/_sPromo.pug

block variables
	- var mainPage = 'main-page'

//- Страница лежит в public/dev/ — относительные пути к css/js/img
//- промахиваются на уровень без base(href="../").
block base
	base(href="../")

block title
	- var title = 'DEV — sPromo'
	title= title

block pagecontent
	main
		+sPromo()
