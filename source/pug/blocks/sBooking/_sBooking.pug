mixin sBooking(data)
	- data = data || sBooking
	// start sBooking
	+b.SECTION.sBooking.eb-theme--dark.section#sBooking(data-overlap)&attributes(attributes)
		+e.DIV.media(aria-hidden="true")
			picture
				source(media="(min-width: 992px)" srcset=data.photo.desktop)
				img.sBooking__photo(src=data.photo.mobile alt="" loading="lazy" data-parallax)
		+e.DIV.scrim(aria-hidden="true")
		+ebLogoMark().sBooking__decor
		.container.sBooking__inner(data-reveal-from="bottom" data-reveal-stagger="70" data-reveal-group=".sBooking__title, .sBooking__title-tail, .sBooking__form-title, .sBooking__step, .sBooking__submit")
			h2.sBooking__title
				span.visually-hidden= data.titleAccessible
				span.sBooking__title-main(aria-hidden="true")!= data.titleMain
			span.sBooking__title-tail(aria-hidden="true")!= data.titleTail
			+e.DIV.card.eb-theme--light
				+ebLogoMark().sBooking__card-decor
				form.sBooking__form#sBookingForm(novalidate onsubmit="return false" data-booking-form)
					p.sBooking__form-title= data.form.title

					fieldset.sBooking__step.sBooking__step--contacts
						legend.sBooking__step-title= data.form.step1Title

						+e.DIV.field
							input#sBookingName.sBooking__field-input(
								type="text"
								name="name"
								placeholder=" "
								required
								autocomplete="name"
								aria-describedby="sBookingNameError"
							)
							label.sBooking__field-label(for="sBookingName")= data.form.nameLabel
							span.sBooking__field-error#sBookingNameError(role="alert")= data.form.errors.name

						+e.DIV.field
							input#sBookingPhone.sBooking__field-input(
								type="tel"
								name="phone"
								placeholder=" "
								required
								autocomplete="tel"
								aria-describedby="sBookingPhoneError"
							)
							label.sBooking__field-label(for="sBookingPhone")= data.form.phoneLabel
							span.sBooking__field-error#sBookingPhoneError(role="alert")= data.form.errors.phone

					fieldset.sBooking__step.sBooking__step--time
						legend.sBooking__step-title
							+e.SPAN.step-title-text= data.form.step2Title
							span.sBooking__time-hint#sBookingTimeHint(role="status" hidden)= data.form.timeHint

						+e.DIV.time(role="group" aria-describedby="sBookingTimeHint")
							+e.DIV.time-row.--asap
								input.sBooking__time-input#sBookingTime-asap(
									type="radio"
									name="timeSlot"
									value=data.form.time.asap.id
									required
								)
								+e.LABEL.time-option.--wide(for="sBookingTime-asap")= data.form.time.asap.label
							+e.DIV.time-row.--slots
								each opt in data.form.time.slots
									- var optId = "sBookingTime-" + opt.id
									+e.DIV.time-cell
										input.sBooking__time-input(type="radio" name="timeSlot" id=optId value=opt.id required)
										label.sBooking__time-option(for=optId)= opt.label

					+e.DIV.consent
						input#sBookingConsent.sBooking__consent-input(
							type="checkbox"
							name="consent"
							required
							aria-describedby="sBookingConsentError"
						)
						label.sBooking__consent-label(for="sBookingConsent")
							+e.SPAN.consent-box
								+icon('square-check-big').sBooking__consent-icon
							+e.SPAN.consent-text
								= data.form.consentPre
								+e.A.consent-link(href=data.form.consentHref)= data.form.consentLink
						span.sBooking__consent-error#sBookingConsentError(role="alert")= data.form.errors.consent

					button.btn.eb-btn.eb-btn--primary.sBooking__submit(type="submit")
						span.eb-btn__label= data.form.submit
	// end sBooking
