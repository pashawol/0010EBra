mixin sStory(data)
	- data = data || sStory
	// start sStory
	+b.SECTION.sStory.section#sStory(data-swiper-scope)&attributes(attributes)
		.container
			+e.DIV.slider.--js.swiper(data-swiper-options=JSON.stringify({ slidesPerView: 1, loop: data.stories.length > 1, navigation: true, pagination: true }))
				.swiper-wrapper
					each story, i in data.stories
						+e.DIV.slide.swiper-slide
							+e.DIV.grid
								+e.DIV.compare(data-story-compare data-split="30")
									+e.DIV.photo.--before
										img(src=story.photos.before alt="" loading="lazy")
									+e.DIV.photo.--after
										img(src=story.photos.after alt="" loading="lazy")
									+e.SPAN.label.--before= data.beforeLabel
									+e.SPAN.label.--after= data.afterLabel
									+e.DIV.handle
										+e.DIV.handle-line
										+e.BUTTON.handle-btn.swiper-no-swiping(
											type="button"
											role="slider"
											aria-label=data.compareAriaLabel
											aria-valuemin="0"
											aria-valuemax="100"
											aria-valuenow="30"
											aria-orientation="horizontal"
										)
											+icon('move-horizontal', 'sStory__handle-icon')
								+e.DIV.card
									+e.DIV.top
										+e.SPAN.badge= data.badge
										+e.SPAN.year= story.year
									+e.DIV.name
										h3.sStory__name-value= story.name
										p.sStory__age= story.age
									+e.DIV.info
										each param in story.params
											+e.DIV.info-row
												+e.SPAN.info-label= param.label
												+e.SPAN.info-value= param.value
									+e.DIV.result
										p.sStory__result-title= data.resultTitle
										+e.DIV.quote
											img.sStory__avatar(src=story.avatar alt="" loading="lazy" width="52" height="52")
											+e.P.quote-text= story.quote
				+ebSliderNav().sStory__nav
	// end sStory
