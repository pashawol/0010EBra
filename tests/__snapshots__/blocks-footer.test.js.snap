exports[`footer block > matches HTML snapshot 1`] = `
"
<!-- start footer-->
<footer class="footer section eb-theme eb-theme--dark">
  <div class="footer__intro"><img class="footer__intro-img" src="img/footer/bg-photo.webp" alt="" loading="lazy"/>
