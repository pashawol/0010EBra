
mixin ebBtn(text, mode, iconName, href)
	- mode = mode || 'primary'
	if href
		+b.A.btn.eb-btn(class="--" + mode href=href)&attributes(attributes)
			if iconName
				+icon(iconName).eb-btn__icon
			span.eb-btn__label= text
	else
		+b.BUTTON.btn.eb-btn(class="--" + mode type="button")&attributes(attributes)
			if iconName
				+icon(iconName).eb-btn__icon
			span.eb-btn__label= text

mixin ebBtnText(text, href)
	+b.A.eb-btn-text(href=href || '#')&attributes(attributes)
		+e.SPAN.label= text

mixin ebIconBtn(iconName, label, mode)
	- mode = mode || 'solid'
	+b.BUTTON.btn.eb-icon-btn(class="--" + mode type="button" aria-label=label)&attributes(attributes)
		+icon(iconName)

mixin ebSliderNav()
	+b.eb-slider-nav&attributes(attributes)
		+e.DIV.dots.swiper-pagination
		+e.DIV.arrows
			+ebIconBtn('arrow-right', 'Предыдущий слайд').eb-slider-nav__prev.swiper-button-prev
			+ebIconBtn('arrow-right', 'Следующий слайд').eb-slider-nav__next.swiper-button-next

mixin ebTag(text, iconName)
	+b.SPAN.eb-tag&attributes(attributes)
		if iconName
			+icon(iconName).eb-tag__icon
		+e.SPAN.label= text

mixin ebTitle(text, level)
	- level = level || 2
	+b.eb-title&attributes(attributes)
		if level == 1
			h1!= text
		else if level == 3
			h3!= text
		else if level == 4
			h4!= text
		else
			h2!= text

mixin ebFact(value, caption, tagText)
	+b.eb-fact&attributes(attributes)
		if tagText
			+ebTag(tagText).eb-fact__tag
		+e.DIV.value= value
		if caption
			+e.DIV.caption!= caption

mixin ebHotspot(title, text, href)
	if href
		+b.A.eb-hotspot(href=href data-reveal)&attributes(attributes)
			+e.SPAN.dot
			+e.SPAN.card
				+e.SPAN.card-body
					if title
						+e.SPAN.card-title= title
					+e.SPAN.card-text= text
				+icon('arrow-right').eb-hotspot__card-icon
	else
		+b.DIV.eb-hotspot(data-reveal)&attributes(attributes)
			+e.SPAN.dot
			+e.SPAN.card
				+e.SPAN.card-body
					if title
						+e.SPAN.card-title= title
					+e.SPAN.card-text= text
