extends ../../layout/main.pug

//- Строительные леса для QA блока sReels — не боевая страница, удаляется
//- координатором при сдаче (см. docs/coordination/sReels.md). Верстаем ТОЛЬКО
//- свой блок, index.pug не трогаем (границы задачи).
include ../../blocks/sReels/_sReels.pug

block variables
	- let mainPage = 'dev-page'
	- let bg = null
block base
	//- Страница лежит в public/dev/sReels.html (на уровень глубже корня) —
	//- относительные ассеты (css/js/svg) в js-css.pug иначе резолвятся как
	//- public/dev/libs/... и 404-ят. Координатор переопределил здесь `block
	//- base` из main.pug — не зависит от порядка исполнения (см. coordination).
	base(href="../")

block title
	title sReels — dev stand

block pagecontent
	main
		+sReels()

block scripts
	script.
		// ---------------------------------------------------------------
		// DEV-ONLY: локальный Fancybox.bind для группы "sReels".
		//
		// JSCCommon.js уже вызывает Fancybox.bind() для группы "modal"
		// (см. modalCall()), и намеренно НЕ для "sReels" — если бы карточки
		// использовали data-fancybox="modal", их клики попали бы под общий
		// document-click-обработчик modalCall(), который делает
		// document.querySelector(element.dataset.src) без try/catch и мог бы
		// упасть, если бы data-src указывал не на точный id-селектор (риск
		// подтверждён, не гипотеза — см. docs/coordination/sReels.md).
		// Поэтому карточки несут отдельную группу "sReels", и для боевой
		// страницы координатору нужно добавить свой Fancybox.bind — этот
		// инлайн-скрипт здесь только чтобы проверить механику на dev-стенде.
		document.addEventListener('DOMContentLoaded', function () {
			if (typeof Fancybox === 'undefined') return
			Fancybox.bind('[data-fancybox="sReels"]', {
				groupAll: false,
				dragToClose: false,
			})
		})
