//- Section «Самые любимые модели» — node 428:10 (desktop), 692:1129 → 726:551
//- (mobile). Заголовок + 4 карточки товара, без табов.
//-
//- Карточка — общий +ebProductCard (тот же компонент, что и sBestSets), не
//- bespoke-копия — см. docs/coordination/products.md.

mixin sFavorites(data)
	- data = data || sFavorites
	// start sFavorites
	+b.SECTION.sFavorites.section#sFavorites&attributes(attributes)
		.container
			+ebTitle(data.title).sFavorites__title
			+e.DIV.cards
				each product in data.products
					+ebProductCard(product).sFavorites__card
	// end sFavorites
