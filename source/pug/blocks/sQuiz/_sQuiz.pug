mixin sQuiz(data)
	- data = data || sQuiz
	// start sQuiz
	+b.SECTION.sQuiz.section#sQuiz&attributes(attributes)
		+e.DIV.bg(aria-hidden="true")
			picture
				source(media="(min-width: 992px)" srcset="img/sQuiz/bg-desktop.webp")
				img.sQuiz__bg-photo(src="img/sQuiz/bg-mobile.webp" alt="" loading="lazy")
		.container(data-reveal-from="bottom" data-reveal-stagger="70" data-reveal-group=".sQuiz__eyebrow, .sQuiz__title, .sQuiz__row-label, .sQuiz__avatar, .sQuiz__bubble, .sQuiz__hint, .sQuiz__cta")
			+e.DIV.header
				+e.P.eyebrow= data.eyebrow
				+ebTitle(data.title).sQuiz__title.text-center

			+e.DIV.chat
				+e.DIV.row.--visitor
					+e.SPAN.row-label.--visitor= data.visitor.label
					+e.DIV.line.--visitor
						+e.DIV.bubble-col.--visitor
							+e.SPAN.bubble.--visitor= data.visitor.message
							+e.SPAN.dot.--visitor
						+e.DIV.avatar.--visitor
							+icon('user-round').sQuiz__avatar-icon

				+e.DIV.row.--assistant
					+e.SPAN.row-label.--assistant= data.assistant.label
					+e.DIV.line.--assistant
						+e.DIV.avatar.--assistant
							+icon('eb-monogram').sQuiz__avatar-mark
						+e.DIV.bubble-col.--assistant
							+e.SPAN.dot.--assistant
							+e.DIV.messages
								each message in data.assistant.messages
									+e.SPAN.bubble.--assistant= message

			+e.DIV.panel
				+e.DIV.hint
					+icon('message-circle-question').sQuiz__hint-icon
					+e.SPAN.hint-label= data.questionsCount
				+ebBtn(data.cta, 'primary', 'sparkles').sQuiz__cta
	// end sQuiz
