// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`sReels block > matches HTML snapshot 1`] = `
"
<!-- start sReels-->
<section class="sReels section" id="sReels" data-swiper-scope="data-swiper-scope">
  <div class="container sReels__overlay">
    <div class="sReels__intro"><span class="eb-tag sReels__tag"><span class="eb-tag__label">Примеры</span></span>
      <div class="eb-title sReels__title">
        <h2>Когда белье<br>меняет жизнь<br>навсегда</h2>
      </div>
      <p class="sReels__subtitle">Реальные истории
      </p>
      <div class="eb-slider-nav sReels__nav">
        <div class="eb-slider-nav__dots swiper-pagination">
        </div>
        <div class="eb-slider-nav__arrows">
          <button class="eb-icon-btn eb-icon-btn--solid eb-slider-nav__prev swiper-button-prev" type="button" aria-label="Предыдущий слайд">
            <svg class="icon icon-arrow-right ">
              <use xlink:href="img/svg/sprite.svg#arrow-right"></use>
            </svg>
          </button>
          <button class="eb-icon-btn eb-icon-btn--solid eb-slider-nav__next swiper-button-next" type="button" aria-label="Следующий слайд">
            <svg class="icon icon-arrow-right ">
              <use xlink:href="img/svg/sprite.svg#arrow-right"></use>
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>
  <div class="sReels__track">
    <div class="sReels__slider sReels__slider--js swiper" data-swiper-options="{&quot;slidesPerView&quot;:&quot;auto&quot;,&quot;spaceBetween&quot;:16,&quot;watchOverflow&quot;:true,&quot;navigation&quot;:true,&quot;pagination&quot;:true,&quot;breakpoints&quot;:{&quot;992&quot;:{&quot;spaceBetween&quot;:32}}}">
      <div class="swiper-wrapper">
        <div class="sReels__slide swiper-slide">
          <a class="sReels__card has-badges" data-fancybox="sReels" data-src="#sReels-video-0" href="#" aria-label="Смотреть видео: Александра, Я стеснялась своей груди 15 лет"><img class="sReels__poster" src="img/sReels/poster-1.webp" alt="Александра улыбается в кофейне — кадр видео-истории" loading="lazy"/>
            <div class="sReels__card-scrim">
            </div>
            <div class="sReels__card-play" aria-hidden="true"><span class="sReels__play-ring">
              <svg class="icon icon-play  sReels__play-icon">
                <use xlink:href="img/svg/sprite.svg#play"></use>
              </svg></span><span class="sReels__play-label">Play</span>
            </div>
            <p class="sReels__card-quote">Я стеснялась своей груди 15 лет
            </p>
          </a>
          <div class="sReels__person"><img class="sReels__person-avatar" src="img/sReels/avatar-1.webp" alt="Александра, портрет" loading="lazy"/>
            <div class="sReels__person-body"><span class="sReels__person-name">Александра</span><span class="sReels__person-age">34 года</span>
            </div>
          </div>
          <div class="sReels__product"><span class="sReels__product-label">Бюстгальтер</span><span class="sReels__product-title">Entwined Balcony</span>
            <div class="sReels__product-meta"><span class="sReels__product-size">75B</span>
              <div class="sReels__product-color"><span class="sReels__product-color-label">Цвет:</span><span class="sReels__swatch" style="background-color:#2C2B2B"></span>
              </div>
            </div>
          </div>
          <div class="sReels__product-photo"><img src="img/sReels/product-1.webp" alt="Бюстгальтер Entwined Balcony крупным планом" loading="lazy"/>
          </div>
          <div id="sReels-video-0" style="display: none">
            <div class="sReels__video-modal">
              <video poster="img/sReels/poster-1.webp" controls="controls" playsinline="playsinline">
                <source src="" type="video/mp4"/>
              </video>
            </div>
          </div>
        </div>
        <div class="sReels__slide swiper-slide">
          <a class="sReels__card" data-fancybox="sReels" data-src="#sReels-video-1" href="#" aria-label="Смотреть видео: Александра, Нестандартная форма груди"><img class="sReels__poster" src="img/sReels/poster-2.webp" alt="Александра, 46 лет — кадр видео-истории" loading="lazy"/>
            <div class="sReels__card-scrim">
            </div>
            <div class="sReels__card-play" aria-hidden="true"><span class="sReels__play-ring">
              <svg class="icon icon-play  sReels__play-icon">
                <use xlink:href="img/svg/sprite.svg#play"></use>
              </svg></span><span class="sReels__play-label">Play</span>
            </div>
            <p class="sReels__card-quote">Нестандартная форма груди
            </p>
            <div class="sReels__card-person"><span class="sReels__card-person-name">Александра</span><span class="sReels__card-person-age">46 года</span>
            </div>
          </a>
          <div id="sReels-video-1" style="display: none">
            <div class="sReels__video-modal">
              <video poster="img/sReels/poster-2.webp" controls="controls" playsinline="playsinline">
                <source src="" type="video/mp4"/>
              </video>
            </div>
          </div>
        </div>
        <div class="sReels__slide swiper-slide">
          <a class="sReels__card" data-fancybox="sReels" data-src="#sReels-video-2" href="#" aria-label="Смотреть видео: Марина, Теперь ношу открытые вырезы без стеснения"><img class="sReels__poster" src="img/sReels/poster-3.webp" alt="Марина в кофейне — кадр видео-истории" loading="lazy"/>
            <div class="sReels__card-scrim">
            </div>
            <div class="sReels__card-play" aria-hidden="true"><span class="sReels__play-ring">
              <svg class="icon icon-play  sReels__play-icon">
                <use xlink:href="img/svg/sprite.svg#play"></use>
              </svg></span><span class="sReels__play-label">Play</span>
            </div>
            <p class="sReels__card-quote">Теперь ношу открытые вырезы без стеснения
            </p>
            <div class="sReels__card-person"><span class="sReels__card-person-name">Марина</span><span class="sReels__card-person-age">29 лет</span>
            </div>
          </a>
          <div id="sReels-video-2" style="display: none">
            <div class="sReels__video-modal">
              <video poster="img/sReels/poster-3.webp" controls="controls" playsinline="playsinline">
                <source src="" type="video/mp4"/>
              </video>
            </div>
          </div>
        </div>
        <div class="sReels__slide swiper-slide">
          <a class="sReels__card" data-fancybox="sReels" data-src="#sReels-video-3" href="#" aria-label="Смотреть видео: Ольга, Наконец нашла размер, который сидит идеально"><img class="sReels__poster" src="img/sReels/poster-4.webp" alt="Ольга — кадр видео-истории" loading="lazy"/>
            <div class="sReels__card-scrim">
            </div>
            <div class="sReels__card-play" aria-hidden="true"><span class="sReels__play-ring">
              <svg class="icon icon-play  sReels__play-icon">
                <use xlink:href="img/svg/sprite.svg#play"></use>
              </svg></span><span class="sReels__play-label">Play</span>
            </div>
            <p class="sReels__card-quote">Наконец нашла размер, который сидит идеально
            </p>
            <div class="sReels__card-person"><span class="sReels__card-person-name">Ольга</span><span class="sReels__card-person-age">41 год</span>
            </div>
          </a>
          <div id="sReels-video-3" style="display: none">
            <div class="sReels__video-modal">
              <video poster="img/sReels/poster-4.webp" controls="controls" playsinline="playsinline">
                <source src="" type="video/mp4"/>
              </video>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
<!-- end sReels-->"
`;
