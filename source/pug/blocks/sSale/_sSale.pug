mixin sSale(data)
	- data = data || sSale
	// start sSale
	+b.SECTION.sSale.section#sSale&attributes(attributes)
		.container
			+e.DIV.inner(data-reveal-from="bottom" data-reveal-stagger="0.12" data-reveal-group=".sSale__eyebrow, .sSale__title, .sSale__text, .sSale__btn")
				+e.P.eyebrow= data.eyebrow
				+e.H2.title!= data.title
				+e.P.text= data.text
				+ebBtn(data.button.label, 'primary', null, data.button.href).sSale__btn
	// end sSale
