mixin icon(name, mod)
	- mod = mod || ''
	svg(class="icon icon-" + name + ' ' + mod)&attributes(attributes)
		use(xlink:href="img/svg/sprite.svg#" + name)

mixin iconC(name, mod)
	- mod = mod || ''
	svg(class="iconC iconC-" + name + ' ' + mod)&attributes(attributes)
		use(xlink:href="img/svg/spriteC.svg#" + name)
