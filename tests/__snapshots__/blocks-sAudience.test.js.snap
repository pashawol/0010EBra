// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`sAudience block > matches HTML snapshot 1`] = `
"
<!-- start sAudience-->
<section class="sAudience section" id="sAudience">
  <div class="container">
    <div class="sAudience__grid">
      <div class="eb-title sAudience__title">
        <h2>Кому помогает<br>Esthetic Bra</h2>
      </div>
      <a class="sAudience__card sAudience__card--small-breast" href="#"><img class="sAudience__card-img" src="img/sAudience/card-small-breast.webp" alt=""/><span class="sAudience__card-text">Маленькая<br>грудь</span><span class="sAudience__card-arrow">
        <svg class="icon icon-arrow-right ">
          <use xlink:href="img/svg/sprite.svg#arrow-right"></use>
        </svg></span>
      </a>
      <a class="sAudience__card sAudience__card--sensitive-skin" href="#"><img class="sAudience__card-img" src="img/sAudience/card-sensitive-skin.webp" alt="" loading="lazy"/><span class="sAudience__card-text">Чувствительная<br>кожа</span><span class="sAudience__card-arrow">
        <svg class="icon icon-arrow-right ">
          <use xlink:href="img/svg/sprite.svg#arrow-right"></use>
        </svg></span>
      </a>
      <a class="sAudience__card sAudience__card--big-breast" href="#"><img class="sAudience__card-img" src="img/sAudience/card-big-breast.webp" alt="" loading="lazy"/><span class="sAudience__card-text">Большая<br>грудь</span><span class="sAudience__card-arrow">
        <svg class="icon icon-arrow-right ">
          <use xlink:href="img/svg/sprite.svg#arrow-right"></use>
        </svg></span>
      </a>
      <a class="sAudience__card sAudience__card--postpartum" href="#"><img class="sAudience__card-img" src="img/sAudience/card-postpartum.webp" alt="" loading="lazy"/><span class="sAudience__card-text">После родов</span><span class="sAudience__card-arrow">
        <svg class="icon icon-arrow-right ">
          <use xlink:href="img/svg/sprite.svg#arrow-right"></use>
        </svg></span>
      </a>
      <a class="sAudience__card sAudience__card--teens" href="#"><img class="sAudience__card-img" src="img/sAudience/card-teens.webp" alt="" loading="lazy"/><span class="sAudience__card-text">Подростки</span><span class="sAudience__card-arrow">
        <svg class="icon icon-arrow-right ">
          <use xlink:href="img/svg/sprite.svg#arrow-right"></use>
        </svg></span>
      </a>
      <a class="sAudience__card sAudience__card--asymmetry" href="#"><img class="sAudience__card-img" src="img/sAudience/card-asymmetry.webp" alt="" loading="lazy"/><span class="sAudience__card-text">Асимметрия<br>груди</span><span class="sAudience__card-arrow">
        <svg class="icon icon-arrow-right ">
          <use xlink:href="img/svg/sprite.svg#arrow-right"></use>
        </svg></span>
      </a>
      <a class="sAudience__card sAudience__card--sport" href="#"><img class="sAudience__card-img" src="img/sAudience/card-sport.webp" alt="" loading="lazy"/><span class="sAudience__card-text">Спорт и<br>активная жизнь</span><span class="sAudience__card-arrow">
        <svg class="icon icon-arrow-right ">
          <use xlink:href="img/svg/sprite.svg#arrow-right"></use>
        </svg></span>
      </a>
      <div class="sAudience__widget">
        <div class="sAudience__avatars"><img class="sAudience__avatar" src="img/sAudience/avatar-1.webp" alt="" loading="lazy" style="z-index: 3"/><img class="sAudience__avatar" src="img/sAudience/avatar-2.webp" alt="" loading="lazy" style="z-index: 2"/><img class="sAudience__avatar" src="img/sAudience/avatar-3.webp" alt="" loading="lazy" style="z-index: 1"/>
        </div><span class="sAudience__widget-text">Делаем женщин счастливее каждый день</span>
      </div>
    </div>
  </div>
</section>
<!-- end sAudience-->"
`;
