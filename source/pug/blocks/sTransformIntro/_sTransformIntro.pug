mixin sTransformIntro(data)
	- data = data || sTransformIntro
	// start sTransformIntro
	+b.SECTION.sTransformIntro.section#sTransformIntro&attributes(attributes)
		.container
			+e.inner
				+e.DIV.watermark(aria-hidden="true")
					+icon('eb-monogram')
				+ebTitle(data.title).sTransformIntro__title.text-center
				each tag in data.tags
					+ebTag(tag.text)(class="sTransformIntro__tag--" + tag.pos)
	// end sTransformIntro
