//- Section «Лучшие наборы белья» — node 384:633 (desktop), 692:1129 → 726:377
//- (mobile). Заголовок + ряд табов-фильтров + 4 карточки товара.
//-
//- Карточка — общий +ebProductCard (source/pug/blocks/mixin-wrap/components/
//- docs/coordination/products.md. Пока подключаем файл напрямую здесь.
//- Второй потребитель того же компонента — sFavorites (428:10).
//-
//- Табы — стандартный WAI-ARIA tabs pattern: все 5 панелей (наборов карточек)
//- лежат в DOM сразу (данные для них есть в source/pug/data/sBestSets.json),
//- неактивные скрыты нативным `hidden` — это не «есть в DOM, не видно на
//- скриншоте» (баг), а штатное поведение табов: `hidden` убирает панель и из
//- accessibility-дерева тоже. Переключение (клик и клавиатура) — js/best-sets.js.

mixin sBestSets(data)
	- data = data || sBestSets
	// start sBestSets
	+b.SECTION.sBestSets.section#sBestSets&attributes(attributes)
		.container
			+ebTitle(data.title).sBestSets__title
			+e.DIV.tabs(role="tablist" aria-label="Фильтр по наборам белья")
				each tab, i in data.tabs
					- let isActive = tab.id === data.activeTab
					+e.BUTTON.tab(
						type="button"
						role="tab"
						id="sBestSets-tab-" + tab.id
						aria-selected=isActive ? "true" : "false"
						aria-controls="sBestSets-panel-" + tab.id
						tabindex=isActive ? "0" : "-1"
						data-tab=tab.id
					)= tab.label
			+e.DIV.panels
				each tab, i in data.tabs
					- let isActive = tab.id === data.activeTab
					+e.DIV.panel(
						role="tabpanel"
						id="sBestSets-panel-" + tab.id
						aria-labelledby="sBestSets-tab-" + tab.id
						hidden=isActive ? undefined : true
						data-tab-panel=tab.id
					)
						+e.DIV.cards
							each product in data.sets[tab.id]
								+ebProductCard(product).sBestSets__card
	// end sBestSets
