// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`sTestimonials block > matches HTML snapshot 1`] = `
"
<!-- start sTestimonials-->
<section class="sTestimonials section" id="sTestimonials" data-swiper-scope="data-swiper-scope">
  <div class="container">
    <div class="eb-title sTestimonials__title">
      <h2>Отзывы</h2>
    </div>
    <div class="sTestimonials__placeholder">
      <p class="sTestimonials__placeholder-note">Сторонний модуль с отзывами
      </p>
    </div>
    <p class="sTestimonials__label">Видео отзывы
    </p>
  </div>
  <div class="sTestimonials__track">
    <div class="sTestimonials__slider sTestimonials__slider--js swiper" data-swiper-options="{&quot;slidesPerView&quot;:&quot;auto&quot;,&quot;spaceBetween&quot;:16,&quot;watchOverflow&quot;:true,&quot;navigation&quot;:true,&quot;pagination&quot;:true,&quot;breakpoints&quot;:{&quot;992&quot;:{&quot;spaceBetween&quot;:32}}}">
      <div class="swiper-wrapper">
        <div class="sTestimonials__slide swiper-slide">
          <a class="sTestimonials__card" data-video-modal="sTestimonialsModal" data-video-index="0" href="#" aria-label="Смотреть видео-отзыв: Александра, Нестандартная форма груди"><img class="sTestimonials__poster" src="img/sTestimonials/poster-1.webp" alt="" loading="lazy"/>
            <div class="sTestimonials__card-scrim">
            </div>
            <svg class="icon icon-play  sTestimonials__play-icon">
              <use xlink:href="img/svg/sprite.svg#play"></use>
            </svg>
            <div class="sTestimonials__card-text">
              <div class="sTestimonials__card-person"><span class="sTestimonials__card-person-name">Александра</span><span class="sTestimonials__card-person-age">46 года</span>
              </div>
              <p class="sTestimonials__card-quote">Нестандартная форма груди
              </p>
            </div>
          </a>
        </div>
        <div class="sTestimonials__slide swiper-slide">
          <a class="sTestimonials__card" data-video-modal="sTestimonialsModal" data-video-index="1" href="#" aria-label="Смотреть видео-отзыв: Анна, После беременности"><img class="sTestimonials__poster" src="img/sTestimonials/poster-2.webp" alt="" loading="lazy"/>
            <div class="sTestimonials__card-scrim">
            </div>
            <svg class="icon icon-play  sTestimonials__play-icon">
              <use xlink:href="img/svg/sprite.svg#play"></use>
            </svg>
            <div class="sTestimonials__card-text">
              <div class="sTestimonials__card-person"><span class="sTestimonials__card-person-name">Анна</span><span class="sTestimonials__card-person-age">29 лет</span>
              </div>
              <p class="sTestimonials__card-quote">После беременности
              </p>
            </div>
          </a>
        </div>
        <div class="sTestimonials__slide swiper-slide">
          <a class="sTestimonials__card" data-video-modal="sTestimonialsModal" data-video-index="2" href="#" aria-label="Смотреть видео-отзыв: Марина, Асимметрия груди"><img class="sTestimonials__poster" src="img/sTestimonials/poster-3.webp" alt="" loading="lazy"/>
            <div class="sTestimonials__card-scrim">
            </div>
            <svg class="icon icon-play  sTestimonials__play-icon">
              <use xlink:href="img/svg/sprite.svg#play"></use>
            </svg>
            <div class="sTestimonials__card-text">
              <div class="sTestimonials__card-person"><span class="sTestimonials__card-person-name">Марина</span><span class="sTestimonials__card-person-age">27 лет</span>
              </div>
              <p class="sTestimonials__card-quote">Асимметрия груди
              </p>
            </div>
          </a>
        </div>
        <div class="sTestimonials__slide swiper-slide">
          <a class="sTestimonials__card" data-video-modal="sTestimonialsModal" data-video-index="3" href="#" aria-label="Смотреть видео-отзыв: Николь, Сложно подобрать размер"><img class="sTestimonials__poster" src="img/sTestimonials/poster-4.webp" alt="" loading="lazy"/>
            <div class="sTestimonials__card-scrim">
            </div>
            <svg class="icon icon-play  sTestimonials__play-icon">
              <use xlink:href="img/svg/sprite.svg#play"></use>
            </svg>
            <div class="sTestimonials__card-text">
              <div class="sTestimonials__card-person"><span class="sTestimonials__card-person-name">Николь</span><span class="sTestimonials__card-person-age">31 год</span>
              </div>
              <p class="sTestimonials__card-quote">Сложно подобрать размер
              </p>
            </div>
          </a>
        </div>
      </div>
    </div>
    <div class="sTestimonials__nav-wrap container">
      <div class="eb-slider-nav sTestimonials__nav">
        <div class="eb-slider-nav__dots swiper-pagination">
        </div>
        <div class="eb-slider-nav__arrows">
          <button class="btn eb-icon-btn eb-icon-btn--solid eb-slider-nav__prev swiper-button-prev" type="button" aria-label="Предыдущий слайд">
            <svg class="icon icon-arrow-right ">
              <use xlink:href="img/svg/sprite.svg#arrow-right"></use>
            </svg>
          </button>
          <button class="btn eb-icon-btn eb-icon-btn--solid eb-slider-nav__next swiper-button-next" type="button" aria-label="Следующий слайд">
            <svg class="icon icon-arrow-right ">
              <use xlink:href="img/svg/sprite.svg#arrow-right"></use>
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>
</section>
<!-- end sTestimonials-->
<div class="video-modal" id="sTestimonialsModal">
  <div class="video-modal__head"><span class="video-modal__title">Видео отзывы</span>
    <button class="btn eb-icon-btn eb-icon-btn--solid video-modal__close" type="button" aria-label="Закрыть" data-fancybox-close="data-fancybox-close">
      <svg class="icon icon-x ">
        <use xlink:href="img/svg/sprite.svg#x"></use>
      </svg>
    </button>
  </div>
  <div class="video-modal__slider swiper">
    <div class="swiper-wrapper">
      <div class="video-modal__slide swiper-slide">
        <video class="video-modal__video" draggable="false" src="video/testimonial-1.mp4" poster="img/sTestimonials/poster-1.webp" controls="controls" playsinline="playsinline" preload="none" data-video-index="0"></video>
      </div>
      <div class="video-modal__slide swiper-slide">
        <video class="video-modal__video" draggable="false" src="video/testimonial-2.mp4" poster="img/sTestimonials/poster-2.webp" controls="controls" playsinline="playsinline" preload="none" data-video-index="1"></video>
      </div>
      <div class="video-modal__slide swiper-slide">
        <video class="video-modal__video" draggable="false" src="video/testimonial-3.mp4" poster="img/sTestimonials/poster-3.webp" controls="controls" playsinline="playsinline" preload="none" data-video-index="2"></video>
      </div>
      <div class="video-modal__slide swiper-slide">
        <video class="video-modal__video" draggable="false" src="video/testimonial-4.mp4" poster="img/sTestimonials/poster-4.webp" controls="controls" playsinline="playsinline" preload="none" data-video-index="3"></video>
      </div>
    </div>
  </div>
  <div class="eb-slider-nav video-modal__nav">
    <div class="eb-slider-nav__dots swiper-pagination">
    </div>
    <div class="eb-slider-nav__arrows">
      <button class="btn eb-icon-btn eb-icon-btn--solid eb-slider-nav__prev swiper-button-prev" type="button" aria-label="Предыдущий слайд">
        <svg class="icon icon-arrow-right ">
          <use xlink:href="img/svg/sprite.svg#arrow-right"></use>
        </svg>
      </button>
      <button class="btn eb-icon-btn eb-icon-btn--solid eb-slider-nav__next swiper-button-next" type="button" aria-label="Следующий слайд">
        <svg class="icon icon-arrow-right ">
          <use xlink:href="img/svg/sprite.svg#arrow-right"></use>
        </svg>
      </button>
    </div>
  </div>
</div>
<!-- end sTestimonials-->"
`;
