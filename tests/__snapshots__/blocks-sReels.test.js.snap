        <div class="eb-slider-nav__arrows">
          <button class="btn eb-icon-btn eb-icon-btn--solid eb-slider-nav__prev swiper-button-prev" type="button" aria-label="Предыдущий слайд">
            <svg class="icon icon-arrow-right ">
              <use xlink:href="img/svg/sprite.svg#arrow-right"></use>
            </svg>
          </button>
          <button class="btn eb-icon-btn eb-icon-btn--solid eb-slider-nav__next swiper-button-next" type="button" aria-label="Следующий слайд">
            <svg class="icon icon-arrow-right ">
              <use xlink:href="img/svg/sprite.svg#arrow-right"></use>
            </svg>
          </button>
