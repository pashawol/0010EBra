              <button class="eb-btn footer__subscribe-btn --secondary" id="footerSubscribeSubmit" type="submit"><span class="eb-btn__label">Подписаться</span></button>
            </div><span class="footer__subscribe-error" id="footerSubscribeError" role="alert">Введите корректный email</span>
          </form>
