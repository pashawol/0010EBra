mixin sCollectionHotspot(item)
	+b.eb-hotspot(class="--" + item.corner data-reveal style=`top:${item.top}%;left:${item.left}%`)
		+e.BUTTON.dot(type="button" aria-label=item.title)
		+e.A.card(href=item.href || '#')
			+e.DIV.card-thumb
				img(src=item.thumb alt="" width="80" height="80" loading="lazy")
			+e.SPAN.card-body
				+e.SPAN.card-title= item.title
				+e.SPAN.card-text= item.price
			+icon('arrow-right').eb-hotspot__card-icon

mixin sCollection(data)
	- data = data || sCollection
	// start sCollection
	+b.SECTION.sCollection.eb-theme--dark.section#sCollection(data-swiper-scope)&attributes(attributes)
		+e.DIV.media
			+e.DIV.slider.--js.swiper(data-swiper-options=JSON.stringify({ slidesPerView: 1, loop: data.slides.length > 1, navigation: true, pagination: true }))
				.swiper-wrapper
					each slide, i in data.slides
						+e.DIV.slide.swiper-slide
							img.sCollection__photo(
								src=slide.image
								alt=""
								fetchpriority=(i === 0 ? "high" : null)
								loading=(i === 0 ? null : "lazy")
							)
							.container.sCollection__slide-overlay
								+e.DIV.content
									+e.DIV.top
										+e.SPAN.badge= slide.badge
										+ebTitle(slide.title, 2).sCollection__title
									+e.P.text.d-none.d-sm-block= slide.text
									+ebBtn(slide.cta.text, 'secondary', null, slide.cta.href).sCollection__cta
								if slide.hotspots && slide.hotspots.length
									+e.DIV.hotspots
										each spot in slide.hotspots
											+sCollectionHotspot(spot)
			+e.DIV.overlay
				.container.sCollection__overlay-inner
					+e.P.label!= data.label
					+ebSliderNav().sCollection__nav
	// end sCollection
