mixin ebArticleCard(article, mod)
	+b.ARTICLE.eb-article-card(class="sBlog__article--" + mod)
		+e.DIV.media
			img(src=article.image alt="" loading="lazy")
		+e.DIV.body
			+e.H3.title
				a(href=article.href)= article.title
			+e.P.text= article.text
			+e.DIV.meta
				+ebTag(article.category)
				+e.TIME.date(datetime=article.date)= article.dateLabel

mixin sBlog(data)
	- data = data || sBlog
	// start sBlog
	+b.SECTION.sBlog.section#sBlog&attributes(attributes)
		.container
			+e.DIV.grid
				+ebTitle(data.title).sBlog__title
				+ebBtn(data.cta.text, 'primary').sBlog__cta
				each article, i in data.articles
					- let mod = article.featured ? 'feat' : (i === 1 ? 'a' : 'b')
					+ebArticleCard(article, mod)
	// end sBlog
