// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`top-nav block (fixed bar) > matches HTML snapshot 1`] = `
"
<!-- start top-nav-->
<div class="top-nav">
  <div class="top-nav__inner">
    <div class="top-nav__start">
      <button class="top-nav__burger" type="button" aria-label="Меню" aria-haspopup="dialog" aria-expanded="false" aria-controls="mobileMenu catalogModal" data-mobile-menu-toggle="data-mobile-menu-toggle" data-catalog-open="data-catalog-open">
        <svg class="icon icon-align-justify top-nav__burger-icon">
          <use xlink:href="img/svg/sprite.svg#align-justify"></use>
        </svg>
      </button>
      <button class="top-nav__catalog-btn d-none d-lg-inline-flex" type="button" aria-haspopup="dialog" aria-expanded="false" aria-controls="catalogModal" data-catalog-open="data-catalog-open">
        <svg class="icon icon-gallery-horizontal-end top-nav__catalog-btn-icon">
          <use xlink:href="img/svg/sprite.svg#gallery-horizontal-end"></use>
        </svg><span class="top-nav__catalog-btn-label">Каталог</span>
      </button>
    </div><a class="top-nav__logo d-none d-lg-block" href="#">Esthetic Bra</a>
    <nav class="top-nav__actions" aria-label="Аккаунт и покупки"><a class="top-nav__action" href="#" aria-label="Поиск" data-action="search">
        <svg class="icon icon-search top-nav__action-icon">
          <use xlink:href="img/svg/sprite.svg#search"></use>
        </svg></a><a class="top-nav__action" href="#" aria-label="Профиль" data-action="profile">
        <svg class="icon icon-user-round top-nav__action-icon">
          <use xlink:href="img/svg/sprite.svg#user-round"></use>
        </svg></a><a class="top-nav__action" href="#" aria-label="Избранное" data-action="favorites">
        <svg class="icon icon-heart top-nav__action-icon">
          <use xlink:href="img/svg/sprite.svg#heart"></use>
        </svg></a><a class="top-nav__action" href="#" aria-label="Корзина" data-action="cart">
        <svg class="icon icon-shopping-cart top-nav__action-icon">
          <use xlink:href="img/svg/sprite.svg#shopping-cart"></use>
        </svg></a>
    </nav>
  </div>
  <div class="catalog-modal" id="catalogModal" role="dialog" aria-modal="true" aria-label="Каталог" tabindex="-1" hidden="hidden">
    <div class="catalog-modal__backdrop" data-catalog-close="data-catalog-close"></div>
    <div class="catalog-modal__dialog">
      <div class="catalog-modal__head"><span class="catalog-modal__title">Каталог</span>
        <button class="catalog-modal__close" type="button" aria-label="Закрыть каталог" data-catalog-close="data-catalog-close">
          <svg class="icon icon-x catalog-modal__close-icon">
            <use xlink:href="img/svg/sprite.svg#x"></use>
          </svg>
        </button>
      </div>
      <div class="catalog-modal__body">
        <div class="catalog-modal__col">
          <ul class="catalog-modal__list">
            <li class="catalog-modal__item --has-children"><a class="catalog-modal__item-link" href="#" data-catalog-trigger="0" aria-haspopup="true" aria-expanded="false"><span class="catalog-modal__item-title">Нижнее бельё</span><span class="catalog-modal__item-count">654</span>
                <svg class="icon icon-arrow-right catalog-modal__item-arrow">
                  <use xlink:href="img/svg/sprite.svg#arrow-right"></use>
                </svg></a></li>
            <li class="catalog-modal__item"><a class="catalog-modal__item-link" href="#"><span class="catalog-modal__item-title">Спортивное бельё</span><span class="catalog-modal__item-count">32</span></a></li>
            <li class="catalog-modal__item"><a class="catalog-modal__item-link" href="#"><span class="catalog-modal__item-title">Эротическое бельё</span><span class="catalog-modal__item-count">12</span></a></li>
            <li class="catalog-modal__item --has-children"><a class="catalog-modal__item-link" href="#" data-catalog-trigger="3" aria-haspopup="true" aria-expanded="false"><span class="catalog-modal__item-title">Купальники</span><span class="catalog-modal__item-count">876</span>
                <svg class="icon icon-arrow-right catalog-modal__item-arrow">
                  <use xlink:href="img/svg/sprite.svg#arrow-right"></use>
                </svg></a></li>
            <li class="catalog-modal__item --has-children"><a class="catalog-modal__item-link" href="#" data-catalog-trigger="4" aria-haspopup="true" aria-expanded="false"><span class="catalog-modal__item-title">Домашняя одежда</span><span class="catalog-modal__item-count">546</span>
                <svg class="icon icon-arrow-right catalog-modal__item-arrow">
                  <use xlink:href="img/svg/sprite.svg#arrow-right"></use>
                </svg></a></li>
            <li class="catalog-modal__item"><a class="catalog-modal__item-link" href="#"><span class="catalog-modal__item-title">Одежда для сна</span><span class="catalog-modal__item-count">45</span></a></li>
            <li class="catalog-modal__item"><a class="catalog-modal__item-link" href="#"><span class="catalog-modal__item-title">Пляжная одежда</span><span class="catalog-modal__item-count">36</span></a></li>
            <li class="catalog-modal__item"><a class="catalog-modal__item-link" href="#"><span class="catalog-modal__item-title">Аксессуары</span><span class="catalog-modal__item-count">11</span></a></li>
            <li class="catalog-modal__item"><a class="catalog-modal__item-link" href="#"><span class="catalog-modal__item-title">По виду груди</span><span class="catalog-modal__item-count">943</span></a></li>
          </ul>
          <nav class="catalog-modal__links d-none d-lg-flex" aria-label="Дополнительные разделы"><a class="catalog-modal__link" href="#"><span>Главная</span></a><a class="catalog-modal__link" href="#"><span>Акции</span></a><a class="catalog-modal__link" href="#"><span>Услуги</span>
              <svg class="icon icon-arrow-right catalog-modal__link-icon">
                <use xlink:href="img/svg/sprite.svg#arrow-right"></use>
              </svg></a><a class="catalog-modal__link" href="#"><span>О нас</span>
              <svg class="icon icon-arrow-right catalog-modal__link-icon">
                <use xlink:href="img/svg/sprite.svg#arrow-right"></use>
              </svg></a><a class="catalog-modal__link" href="#"><span>О брафиттинге</span></a><a class="catalog-modal__link" href="#"><span>Информация</span>
              <svg class="icon icon-arrow-right catalog-modal__link-icon">
                <use xlink:href="img/svg/sprite.svg#arrow-right"></use>
              </svg></a><a class="catalog-modal__link" href="#"><span>Бренды</span></a><a class="catalog-modal__link" href="#"><span>Контакты</span></a>
          </nav>
        </div>
        <div class="catalog-modal__panels">
          <div class="catalog-modal__panel" data-catalog-panel="0">
            <div class="catalog-modal__panel-head d-lg-none">
              <button class="catalog-modal__back" type="button" data-catalog-back="data-catalog-back">
                <svg class="icon icon-arrow-right catalog-modal__back-icon">
                  <use xlink:href="img/svg/sprite.svg#arrow-right"></use>
                </svg><span>Нижнее бельё</span>
              </button>
            </div><span class="catalog-modal__panel-label d-none d-lg-block">Нижнее бельё</span>
            <ul class="catalog-modal__panel-list">
              <li class="catalog-modal__panel-item"><a class="catalog-modal__panel-card --all" href="#"><img class="catalog-modal__panel-card-img" src="img/sAudience/card-asymmetry.webp" alt="" loading="lazy"/><span class="catalog-modal__panel-card-label">Смотреть все</span></a></li>
              <li class="catalog-modal__panel-item"><a class="catalog-modal__panel-card" href="#"><img class="catalog-modal__panel-card-img" src="img/sAudience/card-asymmetry.webp" alt="" loading="lazy"/><span class="catalog-modal__panel-card-label">Бюстгальтеры</span></a></li>
              <li class="catalog-modal__panel-item"><a class="catalog-modal__panel-card" href="#"><img class="catalog-modal__panel-card-img" src="img/sAudience/card-asymmetry.webp" alt="" loading="lazy"/><span class="catalog-modal__panel-card-label">Трусы</span></a></li>
              <li class="catalog-modal__panel-item"><a class="catalog-modal__panel-card" href="#"><img class="catalog-modal__panel-card-img" src="img/sAudience/card-asymmetry.webp" alt="" loading="lazy"/><span class="catalog-modal__panel-card-label">Комплекты</span></a></li>
              <li class="catalog-modal__panel-item"><a class="catalog-modal__panel-card" href="#"><img class="catalog-modal__panel-card-img" src="img/sAudience/card-asymmetry.webp" alt="" loading="lazy"/><span class="catalog-modal__panel-card-label">Корректирующее бельё</span></a></li>
            </ul>
          </div>
          <div class="catalog-modal__panel" data-catalog-panel="3">
            <div class="catalog-modal__panel-head d-lg-none">
              <button class="catalog-modal__back" type="button" data-catalog-back="data-catalog-back">
                <svg class="icon icon-arrow-right catalog-modal__back-icon">
                  <use xlink:href="img/svg/sprite.svg#arrow-right"></use>
                </svg><span>Купальники</span>
              </button>
            </div><span class="catalog-modal__panel-label d-none d-lg-block">Купальники</span>
            <ul class="catalog-modal__panel-list">
              <li class="catalog-modal__panel-item"><a class="catalog-modal__panel-card --all" href="#"><img class="catalog-modal__panel-card-img" src="img/sHero/hero-slide-1.webp" alt="" loading="lazy"/><span class="catalog-modal__panel-card-label">Смотреть все</span></a></li>
              <li class="catalog-modal__panel-item"><a class="catalog-modal__panel-card" href="#"><img class="catalog-modal__panel-card-img" src="img/sHero/hero-slide-1.webp" alt="" loading="lazy"/><span class="catalog-modal__panel-card-label">Купальник раздельный</span></a></li>
              <li class="catalog-modal__panel-item"><a class="catalog-modal__panel-card" href="#"><img class="catalog-modal__panel-card-img" src="img/sHero/hero-slide-1.webp" alt="" loading="lazy"/><span class="catalog-modal__panel-card-label">Купальник слитный</span></a></li>
              <li class="catalog-modal__panel-item"><a class="catalog-modal__panel-card" href="#"><img class="catalog-modal__panel-card-img" src="img/sHero/hero-slide-1.webp" alt="" loading="lazy"/><span class="catalog-modal__panel-card-label">Плавки</span></a></li>
              <li class="catalog-modal__panel-item"><a class="catalog-modal__panel-card" href="#"><img class="catalog-modal__panel-card-img" src="img/sHero/hero-slide-1.webp" alt="" loading="lazy"/><span class="catalog-modal__panel-card-label">Танкини</span></a></li>
            </ul>
          </div>
          <div class="catalog-modal__panel" data-catalog-panel="4">
            <div class="catalog-modal__panel-head d-lg-none">
              <button class="catalog-modal__back" type="button" data-catalog-back="data-catalog-back">
                <svg class="icon icon-arrow-right catalog-modal__back-icon">
                  <use xlink:href="img/svg/sprite.svg#arrow-right"></use>
                </svg><span>Домашняя одежда</span>
              </button>
            </div><span class="catalog-modal__panel-label d-none d-lg-block">Домашняя одежда</span>
            <ul class="catalog-modal__panel-list">
              <li class="catalog-modal__panel-item"><a class="catalog-modal__panel-card --all" href="#"><img class="catalog-modal__panel-card-img" src="img/sGifts/lingerie.webp" alt="" loading="lazy"/><span class="catalog-modal__panel-card-label">Смотреть все</span></a></li>
              <li class="catalog-modal__panel-item"><a class="catalog-modal__panel-card" href="#"><img class="catalog-modal__panel-card-img" src="img/sGifts/lingerie.webp" alt="" loading="lazy"/><span class="catalog-modal__panel-card-label">Халаты</span></a></li>
              <li class="catalog-modal__panel-item"><a class="catalog-modal__panel-card" href="#"><img class="catalog-modal__panel-card-img" src="img/sGifts/lingerie.webp" alt="" loading="lazy"/><span class="catalog-modal__panel-card-label">Пижамы</span></a></li>
              <li class="catalog-modal__panel-item"><a class="catalog-modal__panel-card" href="#"><img class="catalog-modal__panel-card-img" src="img/sGifts/lingerie.webp" alt="" loading="lazy"/><span class="catalog-modal__panel-card-label">Домашние комплекты</span></a></li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<!-- end top-nav-->"
`;
