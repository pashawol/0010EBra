mixin sReels(data)
	- data = data || sReels
	// start sReels
	+b.SECTION.sReels.section#sReels(data-swiper-scope)&attributes(attributes)
		.container
			+e.grid
				.sReels__overlay
					+e.DIV.intro
						+ebTag(data.tag).sReels__tag
						+ebTitle(data.title, 2).sReels__title
						+e.P.subtitle= data.subtitle
				+e.DIV.track
					+e.DIV.slider.--js.swiper(
						data-swiper-options=JSON.stringify({
							slidesPerView: 1,
							spaceBetween: 16,
							slideToClickedSlide: true,
							navigation: true,
							pagination: true,
							effect: 'coverflow',
							coverflowEffect: {
								rotate: 0,
								stretch: 0,
								depth: 220,
								modifier: 1,
								slideShadows: false
							},
							breakpoints: {
								992: { spaceBetween: 92, coverflowEffect: { depth: 260 } },
								1200: { spaceBetween: 406, coverflowEffect: { depth: 360 } }
							}
						})
					)
						.swiper-wrapper
							each slide, i in data.slides
								+e.DIV.slide.swiper-slide
									+e.A.card(
										data-video-modal="sReelsModal"
										data-video-index=i
										href="#"
										aria-label=`Смотреть видео: ${slide.person ? slide.person.name + ', ' : ''}${slide.quote}`
									)
										img.sReels__poster(src=slide.poster alt="" loading="lazy")
										+e.DIV.card-scrim
										+e.DIV.card-play(aria-hidden="true")
											+e.SPAN.play-ring
												+icon('play').sReels__play-icon
											+e.SPAN.play-label Play
										+icon('play').sReels__card-play-icon(aria-hidden="true")
										+e.P.card-quote!= slide.quote
									if slide.person && slide.person.avatar
										+e.DIV.person
											img.sReels__person-avatar(src=slide.person.avatar alt="" loading="lazy")
											+e.DIV.person-body
												+e.SPAN.person-name= slide.person.name
												+e.SPAN.person-age= slide.person.age
									if slide.product
										+e.DIV.product
											+e.SPAN.product-label= slide.product.label
											+e.SPAN.product-title= slide.product.title
											+e.DIV.product-meta
												+e.SPAN.product-size= slide.product.size
												+e.DIV.product-color
													+e.SPAN.product-color-label Цвет:
													span.sReels__swatch(style=`background-color:${slide.product.colorHex}`)
									if slide.productPhoto
										+e.DIV.product-photo
											img(src=slide.productPhoto.src alt="" loading="lazy")
				+ebSliderNav().sReels__nav

		+videoModal('sReelsModal', data.modalTitle || 'Видео отзывы', data.slides)
