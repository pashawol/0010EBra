mixin sFitting(data)
	- data = data || sFitting
	// start sFitting
	+b.SECTION.sFitting.section#sFitting&attributes(attributes)
		+e.DIV.bg
			img.sFitting__bg-photo(src="img/sFitting/bg-desktop.webp" alt="" loading="lazy" aria-hidden="true" data-parallax)
		.container
			+e.DIV.grid
				+e.DIV.text
					+ebTitle(data.title).sFitting__title
					+e.P.lead= data.text

				+e.DIV.photo-wrap
					+e.DIV.meta
						each info in data.miniInfo
							+e.DIV.meta-item
								+e.SPAN.meta-label= info.label
								+e.SPAN.meta-value= info.value

					+e.DIV.photo-frame
						picture
							source(media="(min-width: 992px)" srcset=data.photo.desktop)
							img.sFitting__photo(src=data.photo.mobile alt="" loading="lazy")

						+e.DIV.arrow.--straight(data-reveal)
							include arrow-straight.svg
						+e.DIV.arrow.--curled(data-reveal)
							include arrow-curled.svg

						each hotspot in data.hotspots
							- var hsRawMods = ((hotspot.modDesktop || "") + " " + (hotspot.modMobile || "")).trim().split(/\s+/).filter(Boolean)
							- var hsMods = hsRawMods.map(function (m) { return "--" + m }).join(" ")
							+ebHotspot(null, hotspot.text).sFitting__hotspot(class=hsMods || null style=`--hs-x-d: ${hotspot.x}%; --hs-y-d: ${hotspot.y}%; --hs-x-m: ${hotspot.xMobile}%; --hs-y-m: ${hotspot.yMobile}%;`)

				+ebFact(data.fact.value, data.fact.caption, data.fact.tag).sFitting__fact
	// end sFitting
