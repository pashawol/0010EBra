extends ../../layout/main.pug

//- Строительные леса для QA блока sReels — не боевая страница, удаляется
//- координатором при сдаче (см. docs/coordination/sReels.md). Верстаем ТОЛЬКО
//- свой блок, index.pug не трогаем (границы задачи).
include ../../blocks/sReels/_sReels.pug

block variables
	- let mainPage = 'dev-page'
	- let bg = null
block base
	//- Страница лежит в public/dev/sReels.html (на уровень глубже корня) —
	//- относительные ассеты (css/js/svg) в js-css.pug иначе резолвятся как
	//- public/dev/libs/... и 404-ят. Координатор переопределил здесь `block
	//- base` из main.pug — не зависит от порядка исполнения (см. coordination).
	base(href="../")

block title
	title sReels — dev stand

block pagecontent
	main
		+sReels()
