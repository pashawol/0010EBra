mixin ebProductCard(product)
	- let hasOldPrice = !!product.oldPrice
	+b.ARTICLE.eb-product-card&attributes(attributes)
		+e.DIV.media
			img.eb-product-card__img(src=product.image alt="" loading="lazy")
			if product.badge
				+e.SPAN.badge(class=product.badge.type === 'new' ? 'is-new' : 'is-sale')= product.badge.text
			if product.swatch
				+e.DIV.swatch
					+e.SPAN.swatch-dot(style=`background-color:${product.swatch.color}`)
					if product.swatch.count
						+e.SPAN.swatch-count= '+' + product.swatch.count
		+e.DIV.body
			+e.P.title= product.title
			+e.DIV.price
				+e.SPAN.price-current= product.price
				if hasOldPrice
					+e.SPAN.price-old= product.oldPrice
